# Copy to .env and fill in. Never commit .env.

# Postgres. This is the schema owner's login: only the migrate step uses it,
# never the web app.
POSTGRES_USER=meshgit
POSTGRES_PASSWORD=
POSTGRES_DB=meshgit

# Auth mode: github (needs the private auth module) or dev (one local user, no login).
# dev signs in every request: never combine it with BIND_ADDR=0.0.0.0 or a public host.
AUTH_MODE=dev

# GitHub auth (only when AUTH_MODE=github)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3001/api/auth/github/callback
JWT_SECRET=
SESSION_SECRET=
# 64 hex chars (32 bytes): openssl rand -hex 32
GITHUB_TOKEN_ENCRYPTION_KEY=

# URLs
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:3001

# Host interface for published ports. Default 127.0.0.1 (this machine only).
# Use 0.0.0.0 only to expose services to your local network.
# BIND_ADDR=127.0.0.1
# BACKEND_PORT=3001
# FRONTEND_PORT=5173
# POSTGRES_PORT=5432

# Per-user spending caps (optional; these are the defaults)
QUOTA_STORAGE_MB=2048
QUOTA_UPLOADS_PER_DAY=100
# Mesh cleanings started per day, including failed ones, so broken files cost CPU too.
QUOTA_PROCESSING_PER_DAY=200
QUOTA_PROJECTS=50

# Passwords for the two least-privilege database logins the web app uses:
# meshgit_app for request queries, meshgit_auth for sign-in and GitHub sync.
# The migrate step sets them; Docker Compose builds the backend's
# APP_DATABASE_URL and AUTH_DATABASE_URL from them.
# Required, 16+ characters, letters, digits, - and _ only. Generate each with: openssl rand -hex 32
APP_DB_PASSWORD=
AUTH_DB_PASSWORD=
