# Copy to .env and fill in. Never commit .env.

# Postgres
POSTGRES_USER=meshgit
POSTGRES_PASSWORD=
POSTGRES_DB=meshgit

# Auth (required by the backend at startup)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3001/api/auth/github/callback
JWT_SECRET=
SESSION_SECRET=
# 64 hex chars (32 bytes): openssl rand -hex 32
GITHUB_TOKEN_ENCRYPTION_KEY=

# URLs
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:3001

# Host interface for published ports. Default 127.0.0.1 (this machine only).
# Use 0.0.0.0 only to expose services to your local network.
# BIND_ADDR=127.0.0.1
# BACKEND_PORT=3001
# FRONTEND_PORT=5173
# POSTGRES_PORT=5432
